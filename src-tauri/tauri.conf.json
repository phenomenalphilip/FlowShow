{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlowShow",
  "version": "2.1.0",
  "identifier": "com.fortchurchmedia.flowshow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FlowShow",
        "width": 1600,
        "height": 950,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 1100,
        "minHeight": 700,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-component-update --disk-cache-size=33554432",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "publisher": "The Fort Church Media",
    "copyright": "© 2026 The Fort Church Media",
    "shortDescription": "Worship presentation software",
    "longDescription": "FlowShow: lyrics, scripture and declarations on screens, stage displays and NDI, with full live control of how the words look.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
